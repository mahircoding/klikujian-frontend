# URL backend langsung (opsional).
# Kosongkan jika frontend memakai proxy /api dari Vite atau nginx.
VITE_API_BASE=https://api.ayosekolah.my.id

# Target backend untuk proxy Vite saat development.
VITE_API_TARGET=http://localhost:8080

# Target backend untuk proxy nginx saat production Docker.
# Contoh jika backend berada di service Docker bernama "backend":
BACKEND_URL=http://backend:3000
